<?xml version="1.0" encoding="utf-8"?>
<!-- Chunky gold game button with a darker bottom lip. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8A5A0E" />
            <stroke android:width="1.5dp" android:color="@color/w_outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F4AE2C"
                android:startColor="#FFE07A" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
