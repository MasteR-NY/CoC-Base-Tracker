<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/section_heading" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:fontFamily="@font/lilita_one" android:textSize="16sp" android:textColor="#FFC531" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" android:visibility="gone" />
    <TextView android:id="@+id/idle_slots" android:layout_width="match_parent" android:layout_height="29dp" android:layout_marginBottom="3dp" android:background="@drawable/row_idle" android:paddingStart="9dp" android:gravity="center_vertical" android:fontFamily="@font/lilita_one" android:textSize="14sp" android:textColor="#8EE04A" android:visibility="gone" />
    <FrameLayout android:id="@+id/upgrade_frame" android:layout_width="match_parent" android:layout_height="32dp">
        <ProgressBar android:id="@+id/row_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progressDrawable="@drawable/row_bar" />
        <ProgressBar android:id="@+id/row_bar_done" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progress="1000" android:progressDrawable="@drawable/row_bar_done" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingStart="2dp" android:paddingEnd="7dp">
            <ImageView android:id="@+id/row_icon" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/icon_circle" android:padding="1.5dp" android:scaleType="fitCenter" android:contentDescription="Upgrade item" />
            <TextView android:id="@+id/goblin_tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:background="@drawable/tag_bg" android:paddingStart="3dp" android:paddingEnd="3dp" android:fontFamily="@font/lilita_one" android:text="GOBLIN" android:textSize="11sp" android:textColor="#8EE04A" android:visibility="gone" />
            <TextView android:id="@+id/row_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/lilita_one" android:textSize="14sp" android:textColor="#FFFFFF" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" />
            <ImageView android:id="@+id/row_clock" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="4dp" android:src="@drawable/ic_clock" android:contentDescription="Countdown" />
            <Chronometer android:id="@+id/timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:fontFamily="@font/lilita_one" android:textSize="14sp" android:textColor="#FFFFFF" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" />
            <TextView android:id="@+id/done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Done ✓" android:fontFamily="@font/lilita_one" android:textSize="14sp" android:textColor="#FFFFFF" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
