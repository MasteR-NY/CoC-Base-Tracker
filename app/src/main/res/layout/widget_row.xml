<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/section_heading" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:fontFamily="@font/lilita_one" android:textSize="16sp" android:textColor="#FFC531" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" android:visibility="gone" />
    <TextView android:id="@+id/idle_slots" android:layout_width="match_parent" android:layout_height="29dp" android:layout_marginBottom="3dp" android:background="@drawable/row_idle" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center_vertical" android:fontFamily="@font/lilita_one" android:textSize="14sp" android:textColor="#8EE04A" android:visibility="gone" />
    <LinearLayout android:id="@+id/availability_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="7dp" android:background="@drawable/row_idle" android:visibility="gone">
        <TextView android:id="@+id/availability_countdown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:fontFamily="@font/lilita_one" android:textColor="#FFF6E6" android:textSize="13sp" />
        <Chronometer android:id="@+id/availability_timer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF6E6" android:textSize="13sp" android:visibility="gone" />
        <TextView android:id="@+id/availability_clock" android:layout_width="96dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFF6E6" android:textSize="11sp" />
    </LinearLayout>
    <FrameLayout android:id="@+id/upgrade_frame" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp">
        <ProgressBar android:id="@+id/row_bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progressDrawable="@drawable/row_bar" />
        <ProgressBar android:id="@+id/row_bar_done" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:max="1000" android:progress="1000" android:progressDrawable="@drawable/row_bar_done" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="7dp" android:paddingTop="5dp" android:paddingBottom="5dp">
            <ImageView android:id="@+id/row_icon" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/icon_circle" android:padding="2dp" android:scaleType="fitCenter" android:contentDescription="Upgrade item" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="7dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/goblin_tag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:background="@drawable/tag_bg" android:paddingStart="3dp" android:paddingEnd="3dp" android:fontFamily="@font/lilita_one" android:text="GOBLIN" android:textSize="11sp" android:textColor="#8EE04A" android:visibility="gone" />
                    <TextView android:id="@+id/row_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/lilita_one" android:textSize="15sp" android:textColor="#FFFFFF" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" />
                </LinearLayout>
                <TextView android:id="@+id/row_boost" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lilita_one" android:textSize="11sp" android:textColor="#FFE6A7" android:visibility="gone" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/row_clock" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_clock" android:contentDescription="Countdown" />
                    <TextView android:id="@+id/readable_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/lilita_one" android:textSize="14sp" android:textColor="#FFFFFF" android:visibility="gone" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" />
                    <Chronometer android:id="@+id/timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/lilita_one" android:textSize="14sp" android:textColor="#FFFFFF" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" />
                    <TextView android:id="@+id/done" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Done ✓" android:fontFamily="@font/lilita_one" android:textSize="14sp" android:textColor="#FFFFFF" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/row_eta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFF1DB" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/row_finish_at" android:layout_width="96dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFF1DB" android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
