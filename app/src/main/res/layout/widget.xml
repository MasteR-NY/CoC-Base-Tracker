<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:background="@drawable/build_header" android:padding="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your village" android:maxLines="1" android:ellipsize="end" android:fontFamily="@font/lilita_one" android:shadowColor="#C0000000" android:shadowDy="1.5" android:shadowRadius="1.5" android:textSize="21sp" android:textColor="#FFFFFF" />
        </LinearLayout>
        <TextView android:id="@+id/choose" android:layout_width="28dp" android:layout_height="40dp" android:gravity="center" android:text="▾" android:textSize="22sp" android:textColor="#FFC531" android:contentDescription="Choose village for this widget" />
        <TextView android:id="@+id/sync" android:layout_width="74dp" android:layout_height="36dp" android:background="@drawable/sync_btn" android:gravity="center" android:text="↻ Sync" android:fontFamily="@font/lilita_one" android:textSize="16sp" android:textColor="#3B2508" android:contentDescription="Sync village export" />
    </LinearLayout>
    <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:maxLines="1" android:textSize="11sp" android:textColor="#EFE3CF" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="3dp" android:scrollbars="vertical" android:cacheColorHint="@android:color/transparent" />
        <TextView android:id="@+id/empty_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:fontFamily="@font/lilita_one" android:textColor="#FFF6E6" android:textSize="14sp" android:text="Import a village, then tap ▾ to choose it." />
    </FrameLayout>
    <TextView android:id="@+id/freshness" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Tap Sync to import your village" android:fontFamily="@font/lilita_one" android:textSize="12sp" android:textColor="#EFE3CF" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
